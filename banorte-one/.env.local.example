# Copia este archivo a .env.local (ya esta en .gitignore) y llena los valores
# desde tu proyecto de Supabase: Project Settings > API.

# Cliente (publico, seguro de exponer en el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# o, si tu proyecto todavia usa el nombre anterior:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor / scripts de seed — NUNCA con prefijo NEXT_PUBLIC_, nunca al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: para correr el agente en modo LIVE con tool-calling real de Claude
# en vez del motor de reglas (fallback). Sin esta variable, todo funciona
# igual mediante el motor de reglas determinista.
ANTHROPIC_API_KEY=
