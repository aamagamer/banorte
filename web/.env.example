# Sin esta variable, el agente corre en modo FALLBACK (reglas deterministas,
# mismos tools MCP) — útil para desarrollar la UI sin gastar créditos de API.
ANTHROPIC_API_KEY=

# Opcional — modelo de Claude a usar en modo LIVE. Verifica el id vigente en
# https://docs.claude.com/en/docs/about-claude/models antes del demo.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Opcional — ruta al entry point del MCP server si no usas el layout de
# monorepo default (web/ y mcp-server/ como carpetas hermanas).
MCP_SERVER_ENTRY=
